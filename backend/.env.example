# Auditeer Configuration
# Works out-of-the-box in "zero_key" mode with zero API keys required!

# Default provider: zero_key | ollama | gemini | openai
DEFAULT_LLM_PROVIDER=zero_key

# Optional: Local On-Premise Ollama (Data Sovereignty / Air-Gapped Mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI / Groq / vLLM Compatible Endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS Origins for Next.js Frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
